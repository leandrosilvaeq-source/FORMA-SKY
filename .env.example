# Forma Sky — variáveis de ambiente do projeto (raiz)
#
# Este arquivo documenta apenas os NOMES das variáveis. Nunca preencha valores
# reais aqui nem faça commit de um arquivo `.env` com segredos.
#
# Uso local do Supabase CLI (ex.: `supabase db push`, `supabase functions deploy`)
# usa a sessão autenticada da CLI (`supabase login`) e o projeto vinculado
# (`supabase link`), não variáveis de ambiente deste arquivo.
#
# As chaves abaixo serão necessárias a partir do Bloco em que Edge Functions
# forem implementadas (backend/). NUNCA usar SUPABASE_SERVICE_ROLE_KEY no
# frontend — apenas em ambiente de servidor (Edge Functions / CI).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
