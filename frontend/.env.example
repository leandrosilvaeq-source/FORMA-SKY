# Forma Sky — frontend (Vite)
#
# Copie este arquivo para `.env.local` e preencha com os valores do projeto
# Supabase (Project Settings > API Keys). Nunca faça commit de `.env.local`.
#
# VITE_SUPABASE_PUBLISHABLE_KEY é a chave pública (publishable), segura para
# uso no navegador — nunca coloque a secret key aqui.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
